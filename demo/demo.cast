[0.053, "o", "\r\n\u001b[1;36m# 🛡️  Agent Firewall Demo: Multi-Step Exfiltration Detection\u001b[0m\r\n"]
[1.538, "o", "\r\n\u001b[1;36m# Step 1: Normal call (search knowledge base) → ALLOWED\u001b[0m\r\n"]
[0.520, "o", "\u001b[0;33m$ curl ...search_kb\u001b[0m\r\n"]
[0.554, "o", "{\r\n    \u001b[1m\"jsonrpc\"\u001b[0m: \u001b[32m\"2.0\"\u001b[0m,\r\n    \u001b[1m\"id\"\u001b[0m: \u001b[33m1\u001b[0m,\r\n    \u001b[1m\"error\"\u001b[0m: {\r\n        \u001b[1m\"code\"\u001b[0m: \u001b[33m-32600\u001b[0m,\r\n        \u001b[1m\"message\"\u001b[0m: \u001b[32m\"BLOCKED by envelope (kill): \"\u001b[0m\r\n    }\r\n}\r\n"]
[1.525, "o", "\r\n\u001b[1;36m# Step 2: Read customer account → ALLOWED (individually)\u001b[0m\r\n"]
